# YAZ Server Environment Variables
# انسخ هذا الملف الى .env وضع القيم الخاصة بك

# مفتاح الادمن للوحة التحكم - غيره لحماية لوحتك
ADMIN_KEY=jana@#5Y

# اختياري: Vercel KV (Redis) لاستمرارية البيانات بعد اعادة النشر
# احصل عليها من: Vercel Dashboard -> Storage -> Create KV
KV_REST_API_URL=https://your-kv-url.upstash.io
KV_REST_API_TOKEN=your_token
KV_URL=redis://...

# اختياري: حماية HWID الصارمة - اذا true، السيريال يعمل على جهاز واحد فقط
STRICT_HWID=false
